{
  "name": "shopping-list",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint . --max-warnings 0",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "oxlint"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.1",
    "solid-js": "2.0.0-rc.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@solidjs/vite-plugin": "3.0.0-next.32",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.9.0",
    "eslint-plugin-de-morgan": "2.1.3",
    "eslint-plugin-only-warn": "1.2.1",
    "eslint-plugin-solid": "0.16.0",
    "eslint-plugin-unicorn": "73.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.7.0",
      "onFail": "download"
    }
  }
}
